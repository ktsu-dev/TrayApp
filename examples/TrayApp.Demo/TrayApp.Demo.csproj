<Project>
  <Sdk Name="Microsoft.NET.Sdk" />
  <Sdk Name="ktsu.Sdk" />
  <Sdk Name="ktsu.Sdk.ConsoleApp" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFrameworks></TargetFrameworks>

    <!-- A worked example, not a shipped artifact. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The persistence stack is assembled here rather than inside ktsu.TrayApp: the library takes
         IPersistenceProvider<string> and nothing else, so a tool picks where its settings live. -->
    <PackageReference Include="ktsu.Essentials" />
    <PackageReference Include="ktsu.Essentials.FileSystemProviders.Native" />
    <PackageReference Include="ktsu.Essentials.PersistenceProviders.ConfigHome" />
    <PackageReference Include="ktsu.Essentials.SerializationProviders.Json" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../TrayApp/TrayApp.csproj" />
  </ItemGroup>

  <!-- Loaded through Assembly.GetManifestResourceStream rather than AvaloniaResource: the tray builds
       its UI in code and never loads XAML, so pulling in the Avalonia resource pipeline for two PNGs
       would be the only reason it needed one. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png" />
  </ItemGroup>
</Project>
